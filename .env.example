# Copy to .env and fill in. Never commit the real .env file.

# Used to sign Flask sessions/cookies
SECRET_KEY=change-me

# Optional: enables the "Find prospects" enrichment button (Companies > Enrich).
# Get a key at https://apollo.io (free tier available).
APOLLO_API_KEY=

# Optional: enables sending email directly from the app via Gmail.
# Use a Gmail "App Password" (not your normal password): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Your Name
